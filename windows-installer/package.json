{
  "name": "cubehero-windows",
  "private": true,
  "version": "1.0.0",
  "description": "CubeHero \u2014 Offline Windows speedcubing arena",
  "author": "CubeHero",
  "main": "main.cjs",
  "scripts": {
    "package": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.cubehero.windows",
    "productName": "CubeHero",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "../release-downloads"
    },
    "files": [
      "main.cjs",
      "dist/**/*",
      "assets/cubehero.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/cubehero.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CubeHero",
      "artifactName": "CubeHero-v1.0.0-Windows-Setup.${ext}"
    },
    "publish": null
  }
}
