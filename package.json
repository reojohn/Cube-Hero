{
  "name": "cube-hero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "prebuild": "node scripts/check-no-public-apk.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:web": "node scripts/check-no-public-apk.mjs",
    "build:web": "npm run typecheck && vite build --outDir dist-web && node scripts/stage-apk-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:engine": "node scripts/test-phase3.mjs",
    "test:ghost": "node scripts/test-ghost.mjs && node scripts/test-ghost-prefetch.mjs",
    "test:cfop": "node scripts/test-cfop.mjs && node scripts/test-cube-visual.mjs && node scripts/test-turning-cube.mjs && node scripts/test-phase3.mjs && node scripts/test-difficulty-levels.mjs",
    "test:levels": "node scripts/test-difficulty-levels.mjs",
    "test:multi": "node scripts/test-multi-ai.mjs",
    "test:art": "node scripts/test-rivals.mjs && node scripts/test-rival-art.mjs && node scripts/test-all-rival-portraits.mjs",
    "test:ai-preload": "node scripts/test-ai-prefetch.mjs",
    "test:journey": "node scripts/test-hero-journey.mjs",
    "test:landing": "node scripts/test-landing.mjs",
    "test:vs": "node scripts/test-vs-intro.mjs",
    "test:phase2": "node scripts/test-phase2-preservation.mjs && npm run test:art && npm run test:vs",
    "test:levelup": "node scripts/test-level-up.mjs",
    "test:profile": "node scripts/test-local-player.mjs",
    "test:avatar": "node scripts/test-player-avatar.mjs && node scripts/test-avatar-presets.mjs",
    "test:solo": "node scripts/test-solo-timer.mjs",
    "test:roster-perf": "node scripts/test-rival-roster-performance.mjs",
    "test:vercel": "node scripts/test-vercel-deploy.mjs",
    "test:mobile-cube": "node scripts/test-mobile-turning-cube.mjs",
    "test:graphics": "node scripts/test-graphics-quality.mjs",
    "test:audio": "node scripts/test-game-audio.mjs",
    "android:setup": "node scripts/setup-android.mjs",
    "android:sync": "npm run build && npx --no-install cap sync android",
    "android:open": "npx --no-install cap open android",
    "android:run": "npm run android:sync && npx --no-install cap run android",
    "test:capacitor": "node scripts/test-capacitor.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/screen-orientation": "^8.0.2",
    "@moishy/cfop": "0.4.0",
    "@moishy/cubing-core": "0.3.3",
    "cubejs": "1.3.2",
    "cubing": "0.66.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
